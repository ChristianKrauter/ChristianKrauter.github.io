{
  "name": "ChristianKrauter.github.io",
  "version": "2.0.0",
  "description": "personal website",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "npm run resizeThumbs && npm run watermark && npm run resizeGallery && node ./scripts/compile.js",
    "serve": "npx --yes serve .",
    "resizeThumbs": "node ./scripts/image-resizer.js assets/img/teaser 800",
    "watermark": "node ./scripts/watermark.js assets/img/photos \"© Chris Krauter\" 1800",
    "resizeGallery": "node ./scripts/image-resizer.js assets/img/photos 700",
    "ieeecopyright": "node ./scripts/add-copyright-ieee.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "upd": "npm-check-updates -u"
  },
  "author": "Christian Krauter",
  "license": "",
  "devDependencies": {
    "bibtex-parse": "^2.1.0",
    "bibtex-tidy": "1.13.0",
    "image-js": "^1.3.0",
    "npm-check-updates": "^19.3.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3"
  }
}
